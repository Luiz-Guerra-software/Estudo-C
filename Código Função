#include<stdio.h>
float numero(){
    float numero;
    printf("\nDigite a sua idade em anos:");
    scanf("%f",&numero);
    return numero;
}
float calculo(float numero){
    float cal;
    cal=numero*365;
    return cal;
}
void apresentar(float numero,float cal){
    printf("\nvc tem %f anos e %f dias de vida'",numero,cal);
}
int main(){
    float nu,ca;
    nu=numero();
    ca=calculo(nu);
    apresentar(nu,ca);
}
