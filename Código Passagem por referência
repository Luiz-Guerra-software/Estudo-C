#include<stdio.h>

void Pedirnumero(int *f){
    printf("\nDigite um valor:");
	scanf("%d",f);
}

void Calculo(int *nume,int *n){
	*nume= 5*(*n-32)/9;
}

void Apresentar(int result,int results){
    printf("\n%d é o resultado apos a conversao do numero %d",result,results);
    }


int main(){
	int pedir;
	int resultado;
	Pedirnumero(&pedir);
	Calculo(&resultado,&pedir);
    Apresentar(resultado,pedir);
}
